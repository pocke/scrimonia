$hid_reports: Array[untyped]
$hid_fail_after: Integer?
$hid_flaky: Integer
$board_millis: Integer
$printed: Array[String]

# 実物の sig は picoruby_library が読み込むため、ここではスタブ固有の追加分だけ宣言する。
class HidKeyboard
  def self.reset: (?Integer? fail_after, ?Integer flaky) -> void
  def self.reports: () -> Array[untyped]
  def self.ready?: () -> bool
end

class Scrimonia
  class Runner
    def print: (*untyped) -> nil
  end
end
